# Получите токен нового бота у https://t.me/BotFather командой /newbot.
TELEGRAM_BOT_TOKEN=
# Telegram ID владельцев бота: настройка группы и резервный доступ. Участников чата сюда добавлять не нужно.
ADMIN_IDS=
DATABASE_PATH=data/badminton.sqlite3
# Необязательно: публичный HTTPS-адрес Mini App (без пути). Без него работает только чат.
MINIAPP_URL=
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8080
